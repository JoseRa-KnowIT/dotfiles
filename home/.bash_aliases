alias cls='clear'
alias dir='ls -al'
alias ll='ls -l'
alias la='ls -A'
alias del='rm'
alias md='mkdir'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias apt-upd='sudo apt update && sudo apt upgrade'
#alias updalv='sudo apt update && sudo apt upgrade -y && sudo apt dist-upgrade && sudo reboot'
